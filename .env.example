# Modèle des variables d'environnement.
# 1. Copiez ce fichier sous le nom .env.local
# 2. Remplacez les valeurs par les vôtres (dans .env.local uniquement)
# Le fichier .env.local n'est JAMAIS envoyé sur Git : vos secrets restent sur votre PC.

# Adresse publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (renseigné à l'étape 2) ---
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : ne jamais la partager ni la mettre dans le code
SUPABASE_SERVICE_ROLE_KEY=
