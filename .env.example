# Modèle des variables d'environnement.
# 1. Copiez ce fichier sous le nom .env.local
# 2. Remplacez les valeurs par les vôtres (dans .env.local uniquement)
# Le fichier .env.local n'est JAMAIS envoyé sur Git : vos secrets restent sur votre PC.

# Adresse publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données (étape 2) ---
# Supabase > bouton « Connect » en haut > onglet « Connection String »
# > choisir « Session pooler », copier l'adresse, puis remplacer [YOUR-PASSWORD]
# par le mot de passe de la base. Sert aux migrations et aux tests de sécurité.
DATABASE_URL=

# --- Supabase pour l'application (étape 3) ---
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : ne jamais la partager ni la mettre dans le code
SUPABASE_SECRET_KEY=

# --- Envoi des emails (invitations, mot de passe oublié) ---
# Service Resend (https://resend.com) > API Keys. Sans clé, en développement,
# les emails sont simplement affichés dans la console du serveur.
RESEND_API_KEY=
# Expéditeur, sur votre domaine vérifié dans Resend. Exemple :
# EMAIL_EXPEDITEUR=e-Paie <noreply@votre-domaine.ga>
EMAIL_EXPEDITEUR=
# Adresse réelle qui reçoit les réponses (facultatif mais conseillé contre le spam).
# Exemple : EMAIL_REPONSE=contact@votre-domaine.ga
EMAIL_REPONSE=
# Adresse de l'équipe e-Paie qui reçoit les alertes (nouvelle inscription, demande Pro).
# Si vide, EMAIL_REPONSE est utilisée.
EMAIL_ALERTES=

# --- Paiement en ligne : Genuka Pay (https://pay.genuka.com > Clés API) ---
GENUKA_API_URL=https://api-pay.genuka.com
# Clé publique (pk_test_... en test, pk_live_... en production) : non secrète
GENUKA_PUBLIC_KEY=
# Clé secrète (sk_...) : ne jamais la partager ni la mettre dans le code
GENUKA_SECRET_KEY=
# Secret de signature des webhooks (Genuka > Webhooks)
GENUKA_WEBHOOK_SECRET=
