# Modèle des variables d'environnement.
# 1. Copiez ce fichier sous le nom .env.local
# 2. Remplacez les valeurs par les vôtres (dans .env.local uniquement)
# Le fichier .env.local n'est JAMAIS envoyé sur Git : vos secrets restent sur votre PC.

# Adresse publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données (étape 2) ---
# Supabase > bouton « Connect » en haut > onglet « Connection String »
# > choisir « Session pooler », copier l'adresse, puis remplacer [YOUR-PASSWORD]
# par le mot de passe de la base. Sert aux migrations et aux tests de sécurité.
DATABASE_URL=

# --- Supabase pour l'application (étape 3) ---
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : ne jamais la partager ni la mettre dans le code
SUPABASE_SECRET_KEY=
