# Modèle des variables d'environnement.
# 1. Copiez ce fichier sous le nom .env.local
# 2. Remplacez les valeurs par les vôtres (dans .env.local uniquement)
# Le fichier .env.local n'est JAMAIS envoyé sur Git : vos secrets restent sur votre PC.

# Adresse publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données (étape 2) ---
# Supabase > bouton « Connect » en haut > onglet « Connection String »
# > choisir « Session pooler », copier l'adresse, puis remplacer [YOUR-PASSWORD]
# par le mot de passe de la base. Sert aux migrations et aux tests de sécurité.
# Si la connexion est coupée (« ECONNRESET »), remplacez le port :5432 par :6543 dans l'adresse.
DATABASE_URL=

# --- Supabase pour l'application (étape 3) ---
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : ne jamais la partager ni la mettre dans le code
SUPABASE_SECRET_KEY=

# --- Envoi des emails (invitations, mot de passe oublié) ---
# Service Resend (https://resend.com) > API Keys. Sans clé, en développement,
# les emails sont simplement affichés dans la console du serveur.
RESEND_API_KEY=
# Expéditeur, sur votre domaine vérifié dans Resend. Exemple :
# EMAIL_EXPEDITEUR=DématPaie <noreply@votre-domaine.ga>
EMAIL_EXPEDITEUR=
# Adresse réelle qui reçoit les réponses (facultatif mais conseillé contre le spam).
# Exemple : EMAIL_REPONSE=contact@votre-domaine.ga
EMAIL_REPONSE=
# Adresse de l'équipe DématPaie qui reçoit les alertes (nouvelle inscription, demande Pro).
# Si vide, EMAIL_REPONSE est utilisée.
EMAIL_ALERTES=

# --- Paiement en ligne : Genuka Pay (https://pay.genuka.com > Clés API) ---
GENUKA_API_URL=https://api-pay.genuka.com
# Clé publique (pk_test_... en test, pk_live_... en production) : non secrète
GENUKA_PUBLIC_KEY=
# Clé secrète (sk_...) : ne jamais la partager ni la mettre dans le code
GENUKA_SECRET_KEY=
# Secret de signature des webhooks (Genuka > Webhooks)
GENUKA_WEBHOOK_SECRET=

# --- Alertes WhatsApp : Twilio (https://console.twilio.com) ---
# Facultatif : sans ces valeurs, les alertes partent seulement par email.
# Account SID (AC...) et Auth Token : page d'accueil de la console Twilio. Ne jamais partager le jeton.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp expéditeur, précédé de « whatsapp: ». En test (bac à sable) : whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Modèle de message approuvé par WhatsApp (HX...), obligatoire en production. Voir README.
TWILIO_WHATSAPP_MODELE=
# Modèle WhatsApp approuvé pour l'avis « votre bulletin est disponible » (HX...), voir README.
# Texte : Bonjour {{1}}, votre bulletin de paie de {{2}} ({{3}}) est disponible dans votre espace salarié : {{4}}. Le télécharger vaut accusé de réception.
TWILIO_WHATSAPP_MODELE_BULLETIN=

# --- WhatsApp par Meta (WhatsApp Cloud API) : prioritaire sur Twilio s'il est renseigné ---
# developers.facebook.com → votre application → WhatsApp → Configuration de l'API
META_WHATSAPP_JETON=
META_WHATSAPP_NUMERO_ID=
# Noms des modèles approuvés (WhatsApp Manager → Modèles). Vides : simple texte (essais).
META_WHATSAPP_MODELE_BULLETIN=
META_WHATSAPP_MODELE_ALERTE=
META_WHATSAPP_LANGUE=fr
# Adresse de rappel /api/meta/whatsapp : jeton de vérification (inventé par vous) et secret de l'application
META_WHATSAPP_JETON_VERIFICATION=
META_APP_SECRET=
# Code de connexion des salariés : nom du modèle « authentification » approuvé (vide pour les essais).
# Après tout changement des réglages META_WHATSAPP_*, lancez : npm run whatsapp:coffre
META_WHATSAPP_MODELE_CODE=
